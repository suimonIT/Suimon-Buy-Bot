# ─────────────────────────────────────────────────────────────────
#  SUI Buy Bot – Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────

# ── Telegram ──────────────────────────────────────────────────────
TELEGRAM_TOKEN=8608491922:AAF5sA145advbPMvclA2Sa3qbzsVx8THrrg


# Channel ID (e.g. -1001234567890) or group ID or @username
TELEGRAM_CHAT_ID=-1001234567890

# Your personal Telegram user ID (optional – locks admin commands to you)
# Get yours from @userinfobot
TELEGRAM_ADMIN_ID=123456789

# ── SUI RPC ───────────────────────────────────────────────────────
# Default: public SUI mainnet node (good enough for low-volume tokens)
# For high-volume tracking use a private RPC (Triton One, Syndica, etc.)
SUI_RPC_URL=https://fullnode.mainnet.sui.io:443

# ── Token to track ────────────────────────────────────────────────
# Full coin type string, e.g.:
#   SUI:     0x2::sui::SUI
#   DEEP:    0xdeeb7a4662eec9f2f3def03fb937a663dddaa2e215b8078a284d026b7946501::deep::DEEP
#   Custom:  0x<PACKAGE_ID>::<MODULE>::<STRUCT>
TRACKED_TOKEN=0xdeeb7a4662eec9f2f3def03fb937a663dddaa2e215b8078a284d026b7946501::deep::DEEP

# Human-readable symbol shown in alerts
TOKEN_SYMBOL=DEEP

# Token decimal places (usually 9 for SUI-native tokens, 6 for bridged stables)
TOKEN_DECIMALS=9

# ── Bot behaviour ─────────────────────────────────────────────────
# How often to poll for new events (seconds). Lower = more real-time but more RPC calls
POLL_INTERVAL=2.0

# Minimum buy size in USD to post an alert (0 = show all buys)
MIN_BUY_USD=0

# ── Price feed (optional) ─────────────────────────────────────────
# CoinGecko Pro API key – optional, increases rate limits
# Get one at https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# ── Extra DEX packages (optional, comma-separated) ────────────────
# Add package IDs of other DEXes you want to monitor
EXTRA_DEX_PACKAGES=
